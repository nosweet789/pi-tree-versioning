{
  "name": "pi-tree-versioning",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace file checkpoints and diffs for pi sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nosweet789/pi-tree-versioning.git"
  },
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "npm run typecheck",
    "test:package": "node --import ./test/isolate.mjs --import tsx --test --test-concurrency=1 test/package.integration.ts",
    "test": "node --import ./test/isolate.mjs --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "diff": "8.0.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}

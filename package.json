{
  "name": "pi-tree-versioning-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace file history for pi sessions (development build).",
  "license": "MIT",
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --import ./test/isolate.mjs --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "diff": "8.0.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
